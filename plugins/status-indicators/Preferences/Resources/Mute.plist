<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
    <string>静音图标</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
            <string>状态</string>
            <key>footerText</key>
            <string>总静音开启时显示实心静音图标，颜色跟随整体外观设置。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
            <string>显示静音图标</string>
			<key>key</key>
			<string>showMute</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
            <string>位置和大小</string>
			<key>footerText</key>
            <string>只控制静音图标的位置和大小，不影响 VPN、网速或颜色逻辑。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
            <string>横向位置（0～100%）</string>
			<key>key</key>
			<string>muteX</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>50</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>100</integer>
			<key>isDecimalPad</key>
			<true/>
			<key>placeholder</key>
			<string>50</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
            <string>纵向位置（-25～100 点）</string>
			<key>key</key>
			<string>muteY</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>25</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>min</key>
			<integer>-25</integer>
			<key>max</key>
			<integer>100</integer>
			<key>isDecimalPad</key>
			<true/>
			<key>placeholder</key>
			<string>25</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
            <string>图标大小（6～20 点）</string>
			<key>key</key>
			<string>muteSize</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>10</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>min</key>
			<integer>6</integer>
			<key>max</key>
			<integer>20</integer>
			<key>isDecimalPad</key>
			<true/>
			<key>placeholder</key>
			<string>10</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
	</array>
</dict>
</plist>
