<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>VPN 位置与样式</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>显示</string>
			<key>footerText</key>
			<string>图标或短文字仅在系统报告 VPN 活动时出现。未知状态不显示，不主动连接 VPN。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示 VPN</string>
			<key>key</key>
			<string>showVPN</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>显示样式</string>
			<key>key</key>
			<string>vpnStyle</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>0</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>锁盾图标</string>
				<string>新盾牌图标</string>
				<string>短文字 VPN</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>3</integer>
			</array>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>竖屏位置</string>
			<key>footerText</key>
			<string>左右位置：0% 最左、100% 最右、50% 中间；上下偏移：负数上移、正数下移。默认 VPN 与网速使用相同字号；开启“单独设置 VPN 大小”后，VPN 尺寸才独立生效。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>左右位置（0～100%）</string>
			<key>key</key>
			<string>vpnX</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>25</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>100</integer>
			<key>isDecimalPad</key>
			<true/>
			<key>placeholder</key>
			<string>25</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>上下偏移（-25～100 点）</string>
			<key>key</key>
			<string>vpnY</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>0</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>min</key>
			<integer>-25</integer>
			<key>max</key>
			<integer>100</integer>
			<key>isDecimalPad</key>
			<true/>
			<key>placeholder</key>
			<string>0</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>单独设置 VPN 大小</string>
			<key>key</key>
			<string>independentVPNSize</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>VPN 字号 / 图标尺寸（点）</string>
			<key>key</key>
			<string>vpnSize</string>
			<key>defaults</key>
			<string>ayao.statusindicators</string>
			<key>default</key>
			<integer>10</integer>
			<key>PostNotification</key>
			<string>ayao.statusindicators/preferences.changed</string>
			<key>min</key>
			<integer>6</integer>
			<key>max</key>
			<integer>20</integer>
			<key>isDecimalPad</key>
			<true/>
			<key>placeholder</key>
			<string>10</string>
			<key>get</key>
			<string>readPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
		</dict>
	</array>
</dict>
</plist>
