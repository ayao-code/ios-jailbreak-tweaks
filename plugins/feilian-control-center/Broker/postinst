#!/bin/sh
set -eu
/bin/launchctl bootout system/ayao.vpncc-auth >/dev/null 2>&1 || true
# No new daemon. RootHide remaps system jobs to user/foreground on this device;
# use the explicit domain as well when removing the historical service.
/bin/launchctl bootout user/foreground/ayao.vpncc-auth >/dev/null 2>&1 || true
rm -f /rootfs/var/run/ayao.vpncc-auth.sock
